# ---- Notion ----
# Create an integration at https://www.notion.so/profile/integrations, copy the secret here.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxx
# The "Meeting Notes" database (ID or full URL). Share it with the integration (... > Connections).
NOTION_DATABASE_ID=
# Optional: the People / Projects databases that the Attendees / Projects RELATION columns point to.
# Leave blank to auto-detect them from the relation columns. They must ALSO be shared with the integration.
NOTION_PEOPLE_DB_ID=
NOTION_PROJECTS_DB_ID=
# The people/projects lists (id + title) are cached in ./cache and refreshed after this many days
CACHE_DAYS=7

# ---- Property names (match your database columns exactly) ----
PROP_TITLE=Title
PROP_TIME=Time finished
PROP_ATTENDEES=Attendees
PROP_PROJECTS=Projects
PROP_FILES=Files & media
PROP_NOTES=Notes
PROP_VIDEO_LINK=Video Link

# ---- Transcription ----
# groq  = fast, uses GROQ_API_KEY (free tier: ~2 h of audio per hour, ~8 h per day)
# local = free and unlimited, offline, needs: pip install -r requirements-local.txt
TRANSCRIBE_PROVIDER=groq
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
LOCAL_WHISPER_MODEL=small
# Optional language code (e.g. en, tl). Blank = auto-detect.
LANGUAGE=

# ---- AI (Groq) ----
GROQ_API_KEY=
# Step 1: title + attendees + projects.   Step 2: full summary.
# Each model has its own free daily token budget, so splitting them gives more headroom.
GROQ_MATCH_MODEL=openai/gpt-oss-20b
GROQ_SUMMARY_MODEL=openai/gpt-oss-120b
# Tokens per minute the app allows itself per model. Free tier is 8000; raise it on a paid plan.
LLM_TPM_BUDGET=7000

# ---- Misc ----
TIMEZONE=Asia/Manila
# Upload the transcript as a .txt into the "Files & media" column
UPLOAD_TRANSCRIPT=true
